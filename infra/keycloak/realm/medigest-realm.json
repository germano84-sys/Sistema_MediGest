{
  "realm": "medigest",
  "enabled": true,
  "displayName": "MediGest",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "verifyEmail": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@medigest.local",
    "fromDisplayName": "MediGest",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "clients": [
    {
      "clientId": "medigest-web",
      "name": "MediGest Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "medigest-dev-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "MediGest API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "medigest-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "medigest-admin-api",
      "name": "MediGest identity administration API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "medigest-local-only-admin-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-medigest-admin-api",
      "enabled": true,
      "serviceAccountClientId": "medigest-admin-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "acr",
    "email",
    "profile",
    "roles",
    "web-origins"
  ]
}
